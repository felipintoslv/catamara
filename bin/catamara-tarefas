#!/usr/bin/env python3
"""Central de Tarefas e Painel Operacional do Catamara.

Conecta-se aos dados ao vivo em ~/.local/state/catamara e ao servidor HTTP:
- Modo TUI (padrao, --tui, --status): exibe painel completo no terminal com arte ASCII oficial da Jangada
- Modo Indicadores (--indicadores): exibe metricas de economia de cota, balanco de cascos e funil de qualidade
- Modo Waybar (--waybar): emite JSON para a barra Waybar
- Modo Demonstracao (--demo): exibe dados simulados para apresentacao
- Modo Web (--web, --servidor): sobe o servidor HTTP local se necessario e abre no navegador
- Modo JSON (--json): emite snapshot bruto do estado em JSON
"""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shutil
import socket
import subprocess
import sys
import time
from typing import Any

# Resolucoes de caminhos e modulos
RAIZ_CATAMARA = Path(__file__).resolve().parents[1]
if str(RAIZ_CATAMARA) not in sys.path:
    sys.path.insert(0, str(RAIZ_CATAMARA))

from core.painel import servidor

# Cores oficiais da Jangada (fichas.json / modo dark)
R = "\033[0m"
B = "\033[1m"
D = "\033[2m"

COR_PRIMARIA = "\033[38;2;149;205;247m"       # #95cdf7 (azul primario jangada)
COR_TEXTO = "\033[38;2;224;227;232m"          # #e0e3e8 (texto principal)
COR_SUAVE = "\033[38;2;193;199;206m"          # #c1c7ce (texto suave / bordas)
COR_ATENCAO = "\033[38;2;208;188;224m"        # #d0bce0 (atencao)

COR_EXEC = "\033[38;2;133;186;255m"           # #85baff (Executando)
COR_REVISAO = "\033[38;2;201;182;242m"        # #c9b6f2 (Em revisao)
COR_CONCLUIDA = "\033[38;2;150;214;168m"      # #96d6a8 (Concluida)
COR_BLOQUEADA = "\033[38;2;242;198;109m"      # #f2c66d (Bloqueada / pendente)
COR_FALHOU = "\033[38;2;240;157;147m"         # #f09d93 (Falhou / rejeitada)

COR_BORDA = "\033[38;5;238m"


def barra_progresso(pct: int | float | None, largura: int = 14, cor: str = COR_PRIMARIA) -> str:
    if pct is None:
        return f"{COR_BORDA}{'░' * largura}{R} {COR_SUAVE}Pendente{R}"
    pct_val = max(0, min(100, int(round(pct))))
    if pct_val < 15:
        cor_efetiva = COR_FALHOU
        cor_texto = COR_FALHOU
    elif pct_val < 30:
        cor_efetiva = COR_BLOQUEADA
        cor_texto = COR_BLOQUEADA
    else:
        cor_efetiva = cor
        cor_texto = COR_TEXTO
    preenchido = int(largura * (pct_val / 100))
    vazio = largura - preenchido
    bloco = "█" * preenchido
    fundo = "░" * vazio
    return f"{cor_efetiva}{bloco}{COR_BORDA}{fundo}{R} {cor_texto}{pct_val:3d}%{R}"


def testar_porta_ativa(host: str, porta: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.4)
        return s.connect_ex((host, porta)) == 0


